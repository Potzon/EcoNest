# Copia este archivo a .env y rellena cada valor (ninguno puede quedar vacío).
# Genera valores seguros con:  python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=
GRAFANA_DB_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
# Mínimo 16 caracteres; la API no arranca con un valor vacío o típico (change-me, admin...).
ADMIN_TOKEN=
